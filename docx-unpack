#!/bin/bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $(basename "$0") file.docx" >&2
  exit 2
fi

input="$1"

if [ ! -f "$input" ]; then
  echo "Error: file not found: $input" >&2
  exit 1
fi

case "$input" in
  *.docx|*.DOCX) ;;
  *)
    echo "Error: input must be a .docx file." >&2
    exit 1
    ;;
esac

dir=$(dirname "$input")
base=$(basename "$input")
stem="${base%.*}"
dest="$dir/${stem}_docx"

if [ -e "$dest" ]; then
  echo "Error: destination already exists: $dest" >&2
  echo "Remove or rename it first." >&2
  exit 1
fi

mkdir -p "$dest"

if ! unzip -q "$input" -d "$dest"; then
  rm -rf "$dest"
  echo "Error: could not unpack DOCX." >&2
  exit 1
fi

if [ ! -f "$dest/[Content_Types].xml" ] || [ ! -f "$dest/word/document.xml" ]; then
  rm -rf "$dest"
  echo "Error: archive does not look like a valid DOCX." >&2
  exit 1
fi

echo "Unpacked to:"
echo "  $dest"
echo
echo "Images are normally in:"
echo "  $dest/word/media/"
echo
echo "Compress them without changing filenames or extensions."
echo "Example of tested apps:"
echo "  https://apps.apple.com/pt/app/lightimage-image-optimizer/id6443814090?l=en-GB&mt=12LightImage - Image Optimizer"
